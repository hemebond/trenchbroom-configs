//
// entities/lights.qc
//
@PointClass
	base(TargetName)
	color(.8 .8 .8)
	size(-8 -8 -8, 8 8 8)
	model({{
		model -> {"path": model, "scale": 0.125},
		         {"path": "tb/info_null.png", "scale": 0.125}
	}})
= info_null : "Used as a positional target for light entities to create a spotlight effect. A target_position can be used instead of this but was kept in Q3A for legacy purposes." []
@PointClass
	base(TargetName)
	color(.8 .8 .8)
	size(-8 -8 -8, 8 8 8)
	model({{
		model -> {"path": model, "scale": 0.125},
		         {"path": "tb/info_notnull.png", "scale": 0.125}
	}})
= info_notnull : "Used as a positional target for entities that can use directional pointing. A target_position can be used instead of this but was kept in Q3A for legacy purposes." [
]
@PointClass
	base(Q3Map2Light)
	color(.65 .65 1)
	size(-8 -8 -8, 8 8 8)
	model({"path": "tb/light.png", "scale": "0.125"})
	model({{
		_sun == 1         -> {"path": "tb/sun.png", "scale": "0.125"},
		{"path": "tb/light.png", "scale": "0.125"}
	}})
= light : "Non-displayed point light source. The -pointscale and -scale arguments to Q3Map2 affect the brightness of these lights. The -skyscale argument affects brightness of entity sun lights." [
]


//
// entities/sounds.qc
//
@PointClass
	color(0 1 0)
	size(-16 -16 -16, 16 16 16)
	model({"path": "tb/sound.png", "scale": "0.125"})
= randomsoundbox : "Random Sound Box" [
	mindelay(float) : "Minimum Delay"
	maxdelay(float) : "Maximum Delay"
	noise1(string)
	noise2(string)
	noise3(string)
	noise4(string)
	noise5(string)
	noise6(string)
	noise7(string)
	noise8(string)
	noise9(string)
	noise10(string)
	noise11(string)
	noise12(string)
	noise13(string)
	noise14(string)
	noise15(string)
	rad_sound(float) : "Sound Radius" : "512"
	rad_sound_inner(float) : : "0" : "inner sound box with no attenuation, default 0"
	spawnflags(flags) =
	[
		32 : "No Spatialize" : 0 : "2D sound only"
	]
	volume(float) : "Volume" : "1"
]
@PointClass
	color(0 1 0.2)
	size(-16 -16 -16, 16 16 16)
	model({"path": "tb/sound.png", "scale": "0.125"})
= soundbox : "Sound Box" [
	rad_sound(integer) : "Sounds Radius" : 512
	volume(integer) : "Volume" : 1
	noise(string) : "Noise" : "sound/doors/e1m2_pillar.ogg" : "Sound file to play"
	delay(float) : "Delay" : "-1"
	minpitch(float) : "Minimum Pitch" : "0.1"
	spawnflags(flags) = [
		1 : "Attenuation 0"
		2 : "Force Loop"
		32 : "No Spatialize" : 0 : "2D sound only"
	]
]


//
// entities/func/water.qc
//
@SolidClass
	color(0 .4 1)
= func_water : "Moveable liquid volume" [
	alpha(float) : "Alpha" : "0.75" : "Transparency of water."
	colormod(color1) : "Color" : ".5 .5 .5" : "Water surface color, normalized RGB values (0-1, 0-1, 0-1).  Example of blue: .3 .45 .6"
	cshift(string) : "Underwater Color" : "64 64 64 128" : "Underwater color, RGB Alpha.  Example of blue: 16 32 48 128"
	deep(integer) : "deep water" : 0 : "Set to 1 if water is placed underwater to prevent physics bugs(default 0)."
	height_water1(float) : "Height1" : "0" : "Height at which the entity will raise to upon being targeted. Each impulse will raise the entity by X units, until reaching the apex. Cannot be reset. Default value is 0"
	height_water2(float) : "Height2" : "0" : "Height at which the entity will raise to upon being targeted. Each impulse will raise the entity by X units, until reaching the apex. Cannot be reset. Default value is 0"
	height_water3(float) : "Height3" : "0" : "Height at which the entity will raise to upon being targeted. Each impulse will raise the entity by X units, until reaching the apex. Cannot be reset. Default value is 0"
	lip(integer) : "Lip" : 0 : "Lip remaining at end of move. Default value is 0"
	mangle(vector) : "Mangle" : "0 0 0" : "Add current to the volume. The value is the strength of the push in the X, Y, and Z directions."
	spawnflags(flags) = [
		1 : "Start Moved" : 0 : "The water will spawn in the final pos and operate in reverse."
	]
	speed(float) : "Move Speed" : "100" : "Determines how fast the water moves (default is 100)."
	targetname(target_source) : "Target Name" : "" : "If set, a func_button or trigger is required to move the water as a door."
	watertype(choices) : "Type of liquid" : "-3" = [
		-3 : "Water"
		-4 : "Slime"
		-5 : "Lava"
	]
]


//
// entities/func/button.qc
//
@SolidClass
	base(Target)
	color(0 .4 1)
= func_button : "When a button is touched by a player, it moves in the direction set by the `angle` key, triggers all its targets, stays pressed by an amount of time set by the `wait` key, then returns to it's original position where it can be operated again." [
	angle(float) : "Direction" : "0" : "Determines the direction in which the button will move (up = -1, down = -2)."
	targetname(target_source) : "Target Name" : "" : "If set, other entities can be used to activate the button along with touch or damage way of doing that."
	speed(float) : "Move Speed" : "50" : "Speed of button's displacement."
	wait(float) : "Return Delay" : "1" : "Number of seconds button stays pressed (default 1, -1 = no return)."
	lip(float) : "Lip" : "4" : "Lip remaining at end of move."
	buttondecal(integer) : "Decal Button" : 0 : "Set to 1 to add extra volume if the brush is a decal."
]


//
// entities/func/door.qc
//
@SolidClass
	base(Target, TargetName)
	color(0 .4 1)
= func_door : "Normal sliding door entity. By default, the door will activate when player walks close to it or when damage is inflicted to it." [
	angle(float) : "Direction" : "0" : "Determines the opening direction of door (up = -1, down = -2)."
	attached_model(string) : "Attached Model" : "" : "name of the model attached to the door"
	dmg(integer) : "Damage Inflicted" : 4 : "Damage to inflict on player when he blocks operation of door (default 4)."
	fake_lighted(integer) : "Fake Lightning" : 0 : "Set to 1 and brush will use fake lightning."
	keyrequired(choices) : "Key Required" : 0 : "Key need to open" = [
		0 : "Unlocked"
		1 : "Red key"
		2 : "Blue key required"
		3 : "Yellow key required"
	]
	lip(float) : "Lip" : "0" : "Lip remaining at end of move. Default value is 0"
	noise(string) : "Noise" : "" : "Sound to play when door opens"
	notouch(integer) : "No Touch" : 0 : "Set to 1 so player can't activate by `use`, such as when the door is targeted by another entity like a trigger or button."
	speed(float) : "Move Speed" : "200" : "Determines how fast the door moves (default is around 200)."
	startnonsolid(integer) : "Starts Non Solid" : 0 : "Set to 1 and brush will be non solid the first second (useful for node graph)."
	rad_sound(integer) : "Sound Radius" : 512 : ""
	spawnflags(flags) = [
		1 : "Start Open" : 0 : "The door will spawn in the open state and operate in reverse."
	]
	volume(float) : "Volume" : 1 : ""
	wait(float) : "Return Delay" : "2" : "Number of seconds before door returns (default 2, -1 = never return)"
]


//
// entities/func/wall.qc
//
@SolidClass
	color(0 .5 .8)
= func_wall : "This is just a solid wall if not inhibitted." [
	displacement(integer) : "Displacement Wall" : 0 : "Set to 1 and brush will be non solid and invisible until a trigger_displacement is used."
	wait(float) : "Wait" : 1 : ""
	spawnflags(flags) = [
		1 : "Start Off"
		2 : "Glowmod"
	]
]


//
// entities/func/ray.qc
//
@SolidClass
	base(TargetName)
	color(.8 .1 1)
= func_ray : "An object that fades in and out when triggered" [
	valpha(color1) : "Alpha Fades" : "0.01 0.75 1" : "Floating-point vector used to define fading in of object: start alpha, end alpha, and time taken to transition."
	spawnflags(flags) = [
		1 : "Start Off"
		2 : "No effects?"
		512 : "Unknown"
	]
]


//
// entities/func/illusionary.qc
//
@SolidClass
	color(0 .5 .8)
= func_illusionary : "A simple entity that looks solid but lets you walk through it. Does not block light." [
	spawnflags(flags) = [
		1 : "Start invisible" : 0 : "When set, the brush will spawn invisible."
		2 : "Dynamic model light" : 0 : "Force dynamic model light on the entity, even if it's a BSP model (or anything else with lightmaps or light colors)."
	]
	targetname(target_source) : "Target Name" : "" : "If set, a func_button or trigger is required to toggle the visibility of the func_illusionary."
	type(boolean) : "Double-sided" : 0 : "Set to 1 to make the model double-sided."
	wait(float) : "Wait" : 0 : "Only when starting invisible. Will fade out after this amount of time."
]


//
// entities/func/train.qc
//
@SolidClass
	color(0 .4 1)
= func_train : "Trains are moving solids that follow a string of path_corner entities. Trains in Q3A are very basic, they also require an origin brush (see notes)." [
	color(color1) : "Model Light Color" : "1 1 1" : "ConstantLight color of .md3 model included with entity. Has no effect on the entity's brushes (default 1 1 1)."
	light(float) : "Model Light Intensity" : "0" : "ConstantLight radius of .md3 model included with entity. Has no effect on the entity's brushes (default 0)."
	model2(string) : "Model File" : "" : "Path/name of model to include (.md3 files only, e.g. models/mapobjects/pipe/pipe02.md3)."
	speed(float) : "Move Speed" : "100" : "Speed of displacement of train (default 100 or overridden by speed value of path)."
	target(target_destination) : "Target" : "" : "This points to the first path_corner of the path which is also the spawn location of the train's origin."
	targetname(target_source) : "Target Name" : "" : "Used to attach a misc_model entity to this entity."
	// -------- NOTES --------
	// 1. Trains always start on in the game.
	// 2. Trains do not damage the player when blocked.
	// 3. Trains cannot emit sound.
	// 4. Trains are not triggerable or toggle-able.
	// 5. Trains cannot be block-stopped just by getting in their way, the player must be wedged between the train and another obstacle to block it.
	//
	// You need to have an origin brush as part of this entity. When using the model2 key, the origin point of the model will correspond to the origin point defined by the origin brush.
	//
	// Target this entity with a misc_model to have the model attached to the entity (set the model's "target" key to the same value as this entity's "targetname").
]


//
// entities/func/flicker.qc
//
@SolidClass = func_flicker : "Causes the brush glow texture to flicker" [
	wait(float) : "Wait" : "0.2" : "time between changes"
	health(float) : "Health" : "0.6" : "intensity of flicker"
	style(choices) : "Style" : 0 = [
		0 : "smooth"
		1 : "choppy"
	]
]


//
// entities/func/shrine.qc
//
@SolidClass color(0 .4 1) = func_shrine [
    targetname(target_source) : "Target Name" : "" : "targetname is required to attach misc_model of shrine."
]


//
// entities/trigger.qc
//
@SolidClass
	base(Target)
	color(0.5 0.0 0.5)
= trigger_multiple : "Variable sized trigger. Triggers multiple times. You must set the key `target` to the name of another object in the level that has a matching `targetname`. If notouch is set, the trigger is only fired by other entities, not by touching. Wait is always -1." [
	angle(float) : "Facing Direction" : : "if set, the trigger will only fire when someone is facing the direction of the angle, use `360` for angle 0."
	delay(float) : "Delay" : : "delay before firing (after being triggered)"
	disarmed(integer) : "Disarmed" : 0 : "It will not fire when player touch, if value = 1 trigger should to be activated"
	health(boolean) : "Shootable" : "0" : "Can be shot to activate"
	monstertouch(choices) : "Activable by monster" : 0 = [
		0 : "monsters will not touch it"
		1 : "monsters can touch and activate it"
		2 : "only monsters will touch and activate it"
	]
	player_weapon(choices) : "if player has this weapon, make this trigger active,0 = no required weapon" : 0 = [
		1 : "Coachgun"
		2 : "Shotgun"
		4 : "Fang Spitter"
		8 : "Retcher"
	]
	spawnflags(flags) = [
		1 : "No Touch" : 0 : "only triggered by other entities, not by touching"
	]
	wait(float) : "Trigger Wait" : "1" : "Number of seconds before trigger can be activated again."
]
@SolidClass
	base(Target)
	color(0.5 0.0 0.5)
= trigger_generic : "Variable sized trigger. Triggers multiple times. You must set the key `target` to the name of another object in the level that has a matching `targetname`. If notouch is set, the trigger is only fired by other entities, not by touching. Wait is always -1." [
	delay(float) : "Delay" : : "delay before firing (after being triggered)"
	disarmed(integer) : "Disarmed" : 0 : "it will not fire when player touch, if value = 1 trigger should to be activated"
	monstertouch(choices) : "Activable by monster" : 0 = [
		0 : "monsters will not touch it"
		1 : "monsters can touch and activate it"
	]
	player_weapon(choices) : "if player has this weapon, make this trigger active,0 = no required weapon" : 0 = [
		1 : "Revolver"
		2 : "Shotgun"
		4 : "Fang Spitter"
		8 : "Retcher"
		16 : "Cannon"
		32 : "Blade"
		64 : "Lance"
		128 : "Crystal"
		1024 : "Mace"
	]
	spawnflags(flags) = [
		1 : "No Touch" : 0 : "Only triggered by other entities, not by touching"
	]
	wait(float) : "Trigger Wait" : "-1" : "Number of seconds before trigger can be activated again. -1 removes after triggering."
]
@SolidClass
	base(Target)
	color(0.5 0.0 0.5)
= trigger_once : "Variable sized trigger. Triggers once, then removes itself. You must set the key `target` to the name of another object in the level that has a matching `targetname`. If notouch is set, the trigger is only fired by other entities, not by touching. Wait is always -1." [
	angle(float) : "Facing Direction" : : "if set, the trigger will only fire when someone is facing the direction of the angle, use `360` for angle 0."
	delay(float) : "Delay" : : "delay before firing (after being triggered)"
	disarmed(integer) : "Disarmed" : 0 : "it will not fire when player touch, if value = 1 trigger should to be activated"
	health(boolean) : "Shootable" : "0" : "can be shot to activate"
	noise(string) : "Noise" : "" : "Sound to play when triggered."
	monstertouch(choices) : "Activable by monster" : 0 = [
		0 : "monsters will not touch it"
		1 : "monsters can touch and activate it"
		2 : "only monsters will touch and activate it"
	]
	player_weapon(choices) : "if player has this weapon, make this trigger active,0 = no required weapon" : 0 = [
		1 : "Revolver"
		2 : "Shotgun"
		4 : "Fang Spitter"
		8 : "Retcher"
		16 : "Cannon"
		32 : "Blade"
		64 : "Lance"
		128 : "Crystal"
		1024 : "Mace"
	]
	respawnable(boolean) : "Restart" : "0" : "Resets trigger so it can be triggered again upon level re-entry"
	sounds(integer) : "Message Sound" : 0 : "Set to 1 to use default centerprint sound. Otherwise uses noise property."
	spawnflags(flags) = [
		1 : "No Touch" : 0 : "only triggered by other entities, not by touching"
	]
]
@PointClass
	color(0.5 0.0 0.5)
	size(-8 -8 -8, 8 8 8)
	model({"path": "tb/trigger_relay.png", "scale": 0.125})
= trigger_relay : "This fixed size trigger cannot be touched, it can only be fired by other events." [
	killtarget(string) : "Remove Target" : : "removes target"
	target(target_destination) : "Target" : : "fires target when triggered"
	delay(float) : "Delay" : "delay before firing (after being triggered)"

	killtarget2(string) : "Remove Target" : : "removes target2"
	target2(target_destination) : "Target" : : "fires target2 when triggered"
	delay2(float) : "Delay" : "delay before firing target2 (after being triggered)"

	killtarget3(string) : "Remove Target" : : "removes target3"
	target3(target_destination) : "Target" : : "fires target3 when triggered"
	delay3(float) : "Delay" : "delay before firing target3 (after being triggered)"

	killtarget4(string) : "Remove Target" : : "removes target4"
	target4(target_destination) : "Target" : : "fires target4 when triggered"
	delay4(float) : "Delay" : "delay before firing target4 (after being triggered)"

	killtarget5(string) : "Remove Target" : : "removes target5"
	target5(target_destination) : "Target" : : "fires target5 when triggered"
	delay5(float) : "Delay" : "delay before firing target5 (after being triggered)"

	killtarget6(string) : "Remove Target" : : "removes target6"
	target6(target_destination) : "Target" : : "fires target6 when triggered"
	delay6(float) : "Delay" : "delay before firing target6 (after being triggered)"

	killtarget7(string) : "Remove Target" : : "removes target7"
	target7(target_destination) : "Target" : : "fires target7 when triggered"
	delay7(float) : "Delay" : "delay before firing target7 (after being triggered)"

	killtarget8(string) : "Remove Target" : : "removes target8"
	target8(target_destination) : "Target" : : "fires target8 when triggered"
	delay8(float) : "Delay" : "delay before firing target8 (after being triggered)"

	message(string) : "Message" : : "displayed when fired"
	spawnflags(flags) = [
		1 : "Use once"
	]
	targetname(target_source) : "Target Name" : :"The Relay will activate when another entity fires this name."
]
@PointClass base(Target, TargetName) color(1 0 1) size(-12 -12 -12, 12 12 12) = trigger_counter : "Acts as an intermediary for an action that takes multiple inputs. If nomessage is not set, it will print `1 more.. ` etc. when triggered and `sequence complete` when finished. After the counter has been triggered `count` times, it will fire all of its targets and remove itself. It's a once-only trigger (i.e. Wait is always -1)." [
    count(integer) : "Count" : 2 : "number of triggers needed to fire own target, default is 2"
]
@SolidClass color(0.5 0.0 0.5) = trigger_turret : "Turn some monsters into turrets." [
	turret_enemy_visible(float) : "Enemy is Visible" : "0" : "Turret model will be avaible only when player is visible"
	angle_deviance(float) : "Angle deviance" : "90" : "range of angles at which the monster will behave as a turret (this is both a positive and negative value, default is 90)"
	target(target_destination) : "Target" : : "if present target info_angle to set y angles"
]
@SolidClass
	base(TargetName)
	color(0.5 0.0 0.5)
= trigger_hurt : "Any object touching this will be hurt." [
	allowoverlap(boolean) : "Overlap" : "0" : "If set to 1, allows overlapping triggers to act as a single trigger"
	dmg(float) : "Damage Inflicted" : "5" : "sets damage, default is 5"
	kill_player(boolean) : "Kill Player" : "0" : "Trigger will kill Player"
	message(string) : "Message" : : "message text"
	only_to_player(boolean) : "Damage only to Player" : "0" : "Trigger will hurt only Player"
	wait(float) : "Return Delay" : "1" : "Number of seconds before trigger will hurt again (default 1, -1 = never do damage again)"
]
@PointClass color(0.5 0.0 0.5) size(-8 -8 -8, 8 8 8) = trigger_artifact_checker : "This fixed size trigger cannot be touched, it can only be fired by other events." [
	target(target_destination) : "Target" : : "fires target when player uses selected artifact"
	type(choices) : "" : "1" : "Artifact used by player that will trigger the entity" = [
		1 : "Mark Revelation"
		2 : "Drowner App"
		3 : "Berseker"
		4 : "Attar"
		5 : "Black Grenade"
		6 : "Life Siphon"
		7 : "Trinket of Respite"
		8 : "Cruel Aegis"
		9 : "Vicious Idol"
		10 : "Ring of Fire"
	]
]


