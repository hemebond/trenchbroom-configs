// Wrath game definition file (.fgd)
// Generated from Wrath QuakeC source comments on 20261007

//
// wrathdefs.qc
//
@include "q3map2.fgd"

@BaseClass = TargetName [
    targetname(target_source) : "Name"
]
@BaseClass = Target [
    target(target_destination) : "Target" : "All entities with a matching targetname will be triggered."
]


//
// main.qc
//
@SolidClass base(Q3Map2Worldspawn) color(0 0 0) = worldspawn : "Only used for the world." [
    message(string) : "Logon Message" : : "Text to print at user logon. Used for name of level."
    music(sound) : "Music File" : : "Path/name of looping .wav file used for level's music (e.g. music/sonic5.wav)."
    gravity(float) : "Gravity" : "800" : "Gravity of level (default normal gravity: 800)."
    episode(choices) : "Episode" : 1 = [
        1 : "Episode 1"
        2 : "Episode 2"
        3 : "Episode 3"
    ]
]


//
// player/camera.qc
//
@PointClass
	size(-16 -16 -16, 16 16 16)
	model("tb/camera.png")
= camera [
	angles(vector) : "Angles" : "0 0 0" : ""
]


//
// player/client.qc
//
@PointClass
	color(.8 .8 .8)
	size(-16 -16 -32, 16 16 32)
= info_player_start : "The normal starting point for a level. Only one is allowed." [
	location(integer) : "Location place" : : "Location place number identifier related to the last trigger_exitlevel touched in the previous level."
	angle(float) : "Yaw Angle" : : "viewing angle when spawning"
]
@PointClass
	color(.7 .7 .7)
	size(-16 -16 -24, 16 16 32)
= info_player_deathmatch : "Normal player spawning location for Q3A levels." [
	angle(float) : "Yaw Angle" : : "Direction in which player will look when spawning in the game. Does not apply to bots."
	target(target_destination) : "Target" : : "This can point at a target_give entity for respawn freebies."
	spawnflags(flags) = [
		1 : "Initial Spawn Point" : 0 : "Makes the spawnpoint the initial place for the player to spawn at the beginning of the game."
	]
]
@PointClass
	color(.8 .8 .8)
	size(-16 -16 -32, 16 16 32)
= info_player_coop : "The normal starting point for a level." [
	location(integer) : "Location place" : : "Location place number identifier related to the last trigger_exitlevel touched in the previous level."
	angle(float) : "Yaw Angle" : : "viewing angle when spawning"
]
@PointClass
	base(TargetName)
	color(.5 0 .5)
	size(-32 -32 -64, 32 32 64)
	model({"path": "models/portals/portal_level_to_hub.md3", "frame": "19"})
= portal_level_to_hub : "A portal back to the hub that is activated by a targeting relic." [
	wait(float) : "Return Delay" : "1" : "delay before firing (after being triggered)"
	map(string) : "Next Map" : "" : "name of the next map, dont use `.bsp` extension"
	location(integer) : "Location place" : 0 : "Location place number identifier related to the next map info_player_start."
]


//
// player/use.qc
//
@PointClass
	color(0 0.4 1)
	size(-12 -12 -16, 12 12 16)
	model({{
		model -> model, "models/objects/switches/e1_switch1.md3"
	}})
= object_switch : "When a switch is used by a player, it moves in the direction set by the `angle` key, triggers all its targets." [
	model(model) : "Model File" : "models/objects/switches/e1_switch1.md3" : "Path/name of model to use"
	angles(vector) : "Angles" : "0 0 0"
	target(target_destination) : "Target" : : "All entities with a matching targetname will be triggered."
	wait(float) : "Return Delay" : "-1" : "Number of seconds button stays pressed (-1 = no return)."
	delay(float) : "Delay" : "0" : "delay before firing (after being used)"
]


//
// intermission.qc
//
@PointClass
	size(-16 -16 -16, 16 16 16)
	model("tb/camera.png")
= info_intermission [
	angles(vector) : "Angles" : "0 0 0" : ""
]


//
// weapons/weapon_system.qc
